"""Componente unificado de Movistar Prosegur e IMOU para Home Assistant."""
import logging
from homeassistant.config_entries import ConfigEntry
from homeassistant.core import HomeAssistant
from homeassistant.helpers.aiohttp_client import async_get_clientsession

from .alarm_api import ProsegurAlarmAPI
from .auth import ProsegurAuth
from .vms_client import ProsegurVMSClient

_LOGGER = logging.getLogger(__name__)

DOMAIN = "prosegur_imou"
PLATFORMS = ["alarm_control_panel", "camera"]


async def async_setup(hass: HomeAssistant, config: dict) -> bool:
    """Inicialización legacy."""
    return True


async def async_setup_entry(hass: HomeAssistant, entry: ConfigEntry) -> bool:
    """Inicialización desde el flujo de configuración visual."""
    hass.data.setdefault(DOMAIN, {})

    username = entry.data.get("username")
    password = entry.data.get("password")
    contract_id = entry.data.get("contract_id")

    # Inicializamos la autenticación y las APIs compartidas
    session = async_get_clientsession(hass)
    auth = ProsegurAuth(username=username, password=password, session=session)
    alarm_api = ProsegurAlarmAPI(auth)
    vms_api = ProsegurVMSClient(auth)

    hass.data[DOMAIN][entry.entry_id] = {
        "auth": auth,
        "alarm_api": alarm_api,
        "vms_api": vms_api,
        "contract_id": contract_id,
    }

    await hass.config_entries.async_forward_entry_setups(entry, PLATFORMS)
    return True


async def async_unload_entry(hass: HomeAssistant, entry: ConfigEntry) -> bool:
    """Desinstala una entrada de configuración."""
    unload_ok = await hass.config_entries.async_unload_platforms(entry, PLATFORMS)
    if unload_ok:
        hass.data[DOMAIN].pop(entry.entry_id)
    return unload_ok
