"""Cliente API para el control de la alarma y fotodetectores PIR de Prosegur."""
import logging
import aiohttp
from .auth import ProsegurAuth

_LOGGER = logging.getLogger(__name__)
ALARM_BASE_URL = "https://mdw-alarmas.proseguralarms.com/alm-exp/api/v1"

class ProsegurAlarmApi:
    """Gestor de peticiones para el panel de alarma y fotodetectores."""

    def __init__(self, session: aiohttp.ClientSession, auth: ProsegurAuth, contract_id: str = ""):
        self._session = session
        self._auth = auth
        self.contract_id = contract_id

    def _get_headers(self) -> dict:
        return {
            "Host": "mdw-alarmas.proseguralarms.com",
            "User-Agent": "Alarmas/1 CFNetwork/3860.400.51 Darwin/25.3.0",
            "Accept": "application/json",
            "Authorization": f"Bearer {self._auth.access_token}",
        }

    async def _request(self, method: str, endpoint: str, json_data: dict | None = None, retry: bool = True) -> dict | None:
        """Envía peticiones gestionando la renovación automática de tokens B2C."""
        token = await self._auth.async_get_token()
        if not token:
            _LOGGER.error("No se pudo obtener el token para la API de la alarma")
            return None

        url = f"{ALARM_BASE_URL}/{endpoint}"
        try:
            async with self._session.request(method, url, headers=self._get_headers(), json=json_data) as resp:
                if resp.status in (401, 403) and retry:
                    _LOGGER.warning("Token caducado en API Alarma (HTTP %s). Renovando...", resp.status)
                    if await self._auth.async_refresh():
                        return await self._request(method, endpoint, json_data, retry=False)

                resp.raise_for_status()
                return await resp.json()
        except Exception as err:
            _LOGGER.error("Error en llamada a la API de Alarma (%s): %s", endpoint, err)
            return None

    async def async_get_status(self) -> dict | None:
        """Recupera el estado actual del panel de alarma."""
        endpoint = f"contracts/{self.contract_id}/status" if self.contract_id else "status"
        return await self._request("GET", endpoint)

    async def async_change_status(self, mode: str) -> bool:
        """Cambia el modo de la alarma ('ARMED', 'PARTIAL', 'DISARMED')."""
        endpoint = f"contracts/{self.contract_id}/status" if self.contract_id else "status"
        payload = {"status": mode}
        res = await self._request("POST", endpoint, json_data=payload)
        return res is not None

    async def async_request_detector_photo(self, detector_id: str) -> str | None:
        """Envía una orden al fotodetector PIR para capturar una imagen."""
        endpoint = f"detectors/{detector_id}/capture"
        data = await self._request("POST", endpoint)
        if data:
            return data.get("imageUrl") or data.get("url")
        return None
