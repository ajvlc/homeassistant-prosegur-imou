"""Entidad de Panel de Alarma para Movistar Prosegur."""
import logging
from homeassistant.components.alarm_control_panel import (
    AlarmControlPanelEntity,
    AlarmControlPanelEntityFeature,
)
from homeassistant.const import (
    STATE_ALARM_ARMED_AWAY,
    STATE_ALARM_ARMED_HOME,
    STATE_ALARM_DISARMED,
)

from .alarm_api import ProsegurAlarmAPI
from .auth import ProsegurAuth

_LOGGER = logging.getLogger(__name__)
DOMAIN = "prosegur_imou"


async def async_setup_entry(hass, entry, async_add_entities):
    """Configura la plataforma del panel de alarma desde la interfaz (ConfigEntry)."""
    # Extraemos las credenciales guardadas en el flujo visual
    config = hass.data[DOMAIN][entry.entry_id]
    username = config["username"]
    password = config["password"]
    contract_id = config["contract_id"]

    # Inicializamos la autenticación y la API
    auth = ProsegurAuth(username, password, contract_id)
    api = ProsegurAlarmAPI(auth)

    # Añadimos la entidad
    async_add_entities([ProsegurAlarmEntity(api, contract_id)], True)


class ProsegurAlarmEntity(AlarmControlPanelEntity):
    """Representación del panel de alarma Prosegur en HA."""

    def __init__(self, api, contract_id):
        self._api = api
        self._state = STATE_ALARM_DISARMED
        self._attr_name = f"Alarma Movistar Prosegur ({contract_id})"
        self._attr_unique_id = f"prosegur_alarm_panel_{contract_id}"
        self._attr_supported_features = (
            AlarmControlPanelEntityFeature.ARM_AWAY
            | AlarmControlPanelEntityFeature.ARM_HOME
        )

    @property
    def state(self):
        """Devuelve el estado actual de la alarma."""
        return self._state

    async def async_update(self):
        """Consulta el estado del panel en la API de Prosegur."""
        res = await self._api.async_get_status()
        if res:
            status = res.get("status", "").upper()
            if status in ("ARMED", "TOTAL"):
                self._state = STATE_ALARM_ARMED_AWAY
            elif status in ("PARTIAL", "NIGHT"):
                self._state = STATE_ALARM_ARMED_HOME
            else:
                self._state = STATE_ALARM_DISARMED

    async def async_alarm_disarm(self, code=None):
        """Desarma la alarma."""
        if await self._api.async_change_status("DISARMED"):
            self._state = STATE_ALARM_DISARMED
            self.async_write_ha_state()

    async def async_alarm_arm_away(self, code=None):
        """Armado Total."""
        if await self._api.async_change_status("ARMED"):
            self._state = STATE_ALARM_ARMED_AWAY
            self.async_write_ha_state()

    async def async_alarm_arm_home(self, code=None):
        """Armado Parcial / Noche."""
        if await self._api.async_change_status("PARTIAL"):
            self._state = STATE_ALARM_ARMED_HOME
            self.async_write_ha_state()
