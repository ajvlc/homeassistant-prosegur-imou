"""Cliente API para el sistema de vídeo VMS de Movistar Prosegur."""
import logging
import aiohttp
from .auth import ProsegurAuth

_LOGGER = logging.getLogger(__name__)
VMS_BASE_URL = "https://mdw-alarmas.proseguralarms.com/alm-vms-exp/vms/admin/api/device"

class ProsegurVmsApi:
    """Gestor de peticiones a la API VMS para las cámaras IMOU."""

    def __init__(self, session: aiohttp.ClientSession, auth: ProsegurAuth):
        self._session = session
        self._auth = auth

    def _get_headers(self) -> dict:
        return {
            "Host": "mdw-alarmas.proseguralarms.com",
            "User-Agent": "Alarmas/1 CFNetwork/3860.400.51 Darwin/25.3.0",
            "Accept": "application/json",
            "Authorization": f"Bearer {self._auth.access_token}",
        }

    async def _request(self, method: str, url: str, retry: bool = True) -> dict | None:
        """Envía peticiones HTTP gestionando la renovación transparente de tokens."""
        token = await self._auth.async_get_token()
        if not token:
            _LOGGER.error("No se pudo obtener token de acceso B2C")
            return None

        try:
            async with self._session.request(method, url, headers=self._get_headers()) as resp:
                if resp.status in (401, 403) and retry:
                    _LOGGER.warning("Token expirado (HTTP %s). Renovando...", resp.status)
                    if await self._auth.async_refresh():
                        return await self._request(method, url, retry=False)

                resp.raise_for_status()
                return await resp.json()
        except Exception as err:
            _LOGGER.error("Error consultando API VMS (%s): %s", url, err)
            return None

    async def async_get_live_url(self, device_id: str) -> str | None:
        """Despierta la cámara y recupera la URL de emisión en directo."""
        # 1. 'Despertamos' el dispositivo en el servidor VMS
        await self._request("GET", f"{VMS_BASE_URL}/{device_id}")

        # 2. Solicitamos la URL de streaming
        data = await self._request("GET", f"{VMS_BASE_URL}/{device_id}/liveurl")
        if data:
            return data.get("url") or data.get("liveUrl") or data.get("data", {}).get("url")
        return None
